// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema


generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
        

model CliUsageStats {
  id          String   @id @default(cuid())
  commandType String   // "commit", "report", "analyze"
  userId      String?  // Anonymous user ID for tracking unique users
  success     Boolean  @default(true)
  metadata    Json?    // Additional data like file count, duration, etc.
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())

  @@map("cli_usage_stats")
}

model AnalyticsCache {
  id        String   @id @default(cuid())
  key       String   @unique // Cache key like "github_stats", "usage_totals"
  data      Json     // Cached data
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("analytics_cache")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  supabaseId    String   @unique
  name          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  apiUsage      ApiUsage[]
  sessions      AuthSession[]
  
  @@map("users")
}

model AuthSession {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([userId])
  @@map("auth_sessions")
}

model ApiUsage {
  id          String   @id @default(cuid())
  userId      String
  provider    String   // 'gemini', 'claude', 'openai'
  operation   String   // 'generateReport', 'generateCommit', etc.
  tokensUsed  Int
  cost        Float    @default(0)
  success     Boolean  @default(true)
  error       String?
  createdAt   DateTime @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId])
  @@index([createdAt])
  @@map("api_usage")
}
